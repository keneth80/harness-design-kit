# ─── Telegram ─────────────────────────────────────────
# @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 봇 사용을 허용할 텔레그램 user ID.
# 단일 사용자면 본인 ID 하나, 다중 허용은 콤마구분(예: 123,456).
# 비워두면 모든 사용자 허용.
TELEGRAM_CHAT_ID=

# ─── LM Studio (OpenAI 호환) ──────────────────────────
# /v1 접미사 자동 보정. http://localhost:1234 도 허용.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-4-26b-a4b-it
# LM Studio는 키 검증 안 함. 임의 문자열.
LMSTUDIO_API_KEY=lm-studio

# ─── Dashboard ────────────────────────────────────────
DASHBOARD_PORT=3800

# ─── Storage ──────────────────────────────────────────
DATA_DIR=./data

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO

# ─── RAG ──────────────────────────────────────────────
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.3

# ─── Context ──────────────────────────────────────────
CONTEXT_WINDOW_TURNS=10
