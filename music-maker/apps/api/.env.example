# === App ===
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=mureka-studio-api

# === Database ===
# (async URL used by app, sync URL used by Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mureka_studio
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mureka_studio

# === Redis (queue + cache + SSE pubsub) ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Storage (S3 / MinIO) ===
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mureka-studio-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
CDN_BASE_URL=http://localhost:9000/mureka-studio-dev

# === Mureka (BACKEND ONLY - NEVER expose to client) ===
MUREKA_API_BASE=https://api.mureka.ai/v1
MUREKA_API_KEY=mk_replace_me
MUREKA_TIMEOUT_S=30

# === Moderation ===
OPENAI_API_KEY=
MODERATION_ENABLED=true

# === Auth ===
JWT_SIGNING_KEY=replace-with-256-bit-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# === Billing / OAuth (later) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Observability ===
SENTRY_DSN_API=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Worker tuning ===
MUREKA_POLL_INTERVAL_S=5
MUREKA_POLL_MAX_COUNT=60
GENERATION_DEFAULT_COST=1
