# ──────────────────────────────────────────────────────────────────
# Music Maker — apps/web .env.example
# ──────────────────────────────────────────────────────────────────
# 자체 BE(FastAPI) 베이스 URL
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# NextAuth
NEXTAUTH_SECRET=please_change_me_local_dev_secret
NEXTAUTH_URL=http://localhost:3000

# MSW (mock) — BE 미가동 시 true, 실제 BE 연결 시 false
NEXT_PUBLIC_USE_MSW=true

# ──────────────────────────────────────────────────────────────────
# !! 절대 추가 금지: MUREKA / OpenAI / Stripe 등 외부 API 키
# !! NEXT_PUBLIC_MUREKA_API_KEY=... 같은 변수는 클라이언트 번들에 노출됨
# !! 모든 외부 API 호출은 자체 BE(apps/api) 경유
# ──────────────────────────────────────────────────────────────────
